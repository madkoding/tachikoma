# =============================================================================
# NEURO-OS Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SurrealDB Configuration
# -----------------------------------------------------------------------------
SURREAL_USER=root
SURREAL_PASS=neuroos_secret_2024

# -----------------------------------------------------------------------------
# Searxng Configuration
# -----------------------------------------------------------------------------
SEARXNG_SECRET=neuroos_searx_secret

# -----------------------------------------------------------------------------
# Ollama Configuration
# -----------------------------------------------------------------------------
# Default models to pull on startup
OLLAMA_MODELS=qwen2.5:3b,qwen2.5-coder:7b,qwen2.5-coder:14b,nomic-embed-text
# Ollama server URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# Timeout for Ollama requests in seconds (default: 120)
# OLLAMA_TIMEOUT_SECS=120
# Default chat model (default: qwen3:0.6b)
# OLLAMA_DEFAULT_MODEL=qwen3:0.6b
# Embedding model (default: nomic-embed-text)
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
RUST_LOG=info,neuro_backend=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Max request body size in bytes (default: 10485760 = 10MB)
# MAX_BODY_SIZE=10485760
# Request timeout in seconds (default: 30)
# REQUEST_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Database Connection (used by backend, chat, memory)
# -----------------------------------------------------------------------------
# DATABASE_URL=ws://localhost:8000
# DATABASE_NS=tachikoma
# DATABASE_DB=tachikoma
# DATABASE_USER=root
# DATABASE_PASS=root

# -----------------------------------------------------------------------------
# Microservice URLs (used by backend gateway)
# -----------------------------------------------------------------------------
# VOICE_SERVICE_URL=http://localhost:8100
# CHECKLISTS_SERVICE_URL=http://localhost:3001
# MUSIC_SERVICE_URL=http://localhost:3002
# CHAT_SERVICE_URL=http://localhost:3003
# MEMORY_SERVICE_URL=http://localhost:3004
# AGENT_SERVICE_URL=http://localhost:3005
# POMODORO_SERVICE_URL=http://localhost:3010
# KANBAN_SERVICE_URL=http://localhost:3006
# NOTE_SERVICE_URL=http://localhost:3007
# DOCS_SERVICE_URL=http://localhost:3008
# CALENDAR_SERVICE_URL=http://localhost:3009
# IMAGE_SERVICE_URL=http://localhost:3011

# -----------------------------------------------------------------------------
# Searxng Search Configuration
# -----------------------------------------------------------------------------
# SEARXNG_URL=http://localhost:8080
# SEARXNG_TIMEOUT_SECS=30
# SEARXNG_MAX_RESULTS=10

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed commands (default: ls,cat,head,tail,wc,...)
# ALLOWED_COMMANDS=ls,cat,head,tail,grep,find,wc,pwd,echo,date,whoami,uname,df,du,free,uptime,which,type,file,stat,tree,env,hostname,git,cargo,npm,node,python,python3,rustc,rg,fd,jq,curl,wget

# -----------------------------------------------------------------------------
# Chat Service Configuration
# -----------------------------------------------------------------------------
# Enable speculative decoding (default: false)
# SPECULATIVE_ENABLED=false
# Draft model for speculative decoding
# DRAFT_MODEL=
# Target model for speculative decoding
# TARGET_MODEL=
# Speculative lookahead tokens (default: 5)
# SPECULATIVE_LOOKAHEAD=5

# -----------------------------------------------------------------------------
# Music Service Configuration
# -----------------------------------------------------------------------------
# Path to yt-dlp binary (default: yt-dlp)
# YTDLP_PATH=yt-dlp
# Path to ffmpeg binary (default: ffmpeg)
# FFMPEG_PATH=ffmpeg
# MusicBrainz API URL (default: https://musicbrainz.org/ws/2)
# MUSICBRAINZ_API=https://musicbrainz.org/ws/2
# CoverArt Archive URL (default: https://coverartarchive.org)
# COVERART_API=https://coverartarchive.org
# Downloads path (default: /data/downloads)
# DOWNLOADS_PATH=/data/downloads

# -----------------------------------------------------------------------------
# Voice Service Configuration
# -----------------------------------------------------------------------------
# Path to Piper TTS binary (default: /app/piper/piper)
# PIPER_BIN=/app/piper/piper
# Voice models directory (default: /app/models)
# MODELS_DIR=/app/models
# Default voice (default: es_MX-claude-high)
# DEFAULT_VOICE=es_MX-claude-high

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
