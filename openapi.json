  },
  "components": {
    "schemas": {
      "BuildInfoDto": {
        "type": "object",
        "description": "Build information for identifying compiled binary",
        "required": [
          "git_hash",
          "build_time",
          "rust_version"
        ],
        "properties": {
          "build_time": {
            "type": "string",
            "description": "Build timestamp"
          },
          "git_hash": {
            "type": "string",
            "description": "Git commit hash (short)"
          },
          "rust_version": {
            "type": "string",
            "description": "Rust version used"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "description": "=============================================================================\nChatMessage - Message in a conversation\n=============================================================================",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "ChatMessageDto": {
        "type": "object",
        "description": "Chat message DTO",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Message content"
          },
          "created_at": {
            "type": "string",
            "description": "Created timestamp"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Message ID"
          },
          "model": {
            "type": "string",
            "description": "Model used (for assistant messages)",
            "nullable": true
          },
          "role": {
            "type": "string",
            "description": "Message role (user, assistant, system)"
          },
          "tokens_completion": {
            "type": "integer",
            "format": "int64",
            "description": "Tokens in completion",
            "nullable": true,
            "minimum": 0
          },
          "tokens_prompt": {
            "type": "integer",
            "format": "int64",
            "description": "Tokens in prompt",
            "nullable": true,
            "minimum": 0
          }
        }
      },
      "ChatMessageRequest": {
        "type": "object",
        "description": "=============================================================================\nChat DTOs\n=============================================================================\nChat message request",
        "required": [
          "message"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional conversation ID (creates new if not provided)",
            "nullable": true
          },
          "message": {
            "type": "string",
            "description": "User message content"
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to stream the response"
          },
          "system_prompt": {
            "type": "string",
            "description": "Optional system prompt override",
            "nullable": true
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "description": "Chat message response",
        "required": [
          "content",
          "conversation_id",
          "message_id",
          "model",
          "tokens_prompt",
          "tokens_completion",
          "processing_time_ms"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Response content"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Conversation ID"
          },
          "extracted_memories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryDto"
            },
            "description": "Memories extracted from conversation"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "description": "Message ID"
          },
          "model": {
            "type": "string",
            "description": "Model used for generation"
          },
          "processing_time_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Processing time in milliseconds",
            "minimum": 0
          },
          "tokens_completion": {
            "type": "integer",
            "format": "int64",
            "description": "Tokens in completion",
            "minimum": 0
          },
          "tokens_prompt": {
            "type": "integer",
            "format": "int64",
            "description": "Tokens used in prompt",
            "minimum": 0
          },
          "tools_used": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tools used during processing"
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "model": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CommandExecuteRequest": {
        "type": "object",
        "description": "Command execution request",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "timeout_seconds": {
            "type": "integer",
            "format": "int64",
            "description": "Optional timeout in seconds",
            "nullable": true,
            "minimum": 0
          },
          "working_directory": {
            "type": "string",
            "description": "Optional working directory",
            "nullable": true
          }
        }
      },
      "CommandResultDto": {
        "type": "object",
        "description": "Command execution result",
        "required": [
          "exit_code",
          "stdout",
          "stderr",
          "duration_ms",
          "timed_out"
        ],
        "properties": {
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Execution duration in ms",
            "minimum": 0
          },
          "exit_code": {
            "type": "integer",
            "format": "int32",
            "description": "Exit code"
          },
          "stderr": {
            "type": "string",
            "description": "Standard error"
          },
          "stdout": {
            "type": "string",
            "description": "Standard output"
          },
          "timed_out": {
            "type": "boolean",
            "description": "Whether command timed out"
          }
        }
      },
      "ConversationDto": {
        "type": "object",
        "description": "Conversation summary",
        "required": [
          "id",
          "title",
          "message_count",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "Created timestamp"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Conversation ID"
          },
          "message_count": {
            "type": "integer",
            "description": "Message count",
            "minimum": 0
          },
