                "schema": {
                  "$ref": "#/components/schemas/MemoryDto"
                }
              }
            }
          },
          "500": {
            "description": "Create error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/memories/search": {
      "post": {
        "tags": [
