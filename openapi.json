{
  "openapi": "3.0.3",
  "info": {
    "title": "TACHIKOMA-OS Backend API",
    "description": "Central orchestrator API for the TACHIKOMA-OS AI ecosystem. Provides LLM gateway, GraphRAG memory, chat, agent tools, and data layer for microservices.",
    "contact": {
      "name": "TACHIKOMA-OS Team"
    },
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/graph/export": {
      "get": {
        "tags": [
          "Graph"
        ],
        "summary": "=============================================================================",
        "description": "Export full graph (for visualization)\n=============================================================================\nGET /api/admin/graph/export\n=============================================================================",
        "operationId": "export_graph",
        "responses": {
          "200": {
            "description": "Full graph export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphExportDto"
                }
              }
            }
          },
          "500": {
            "description": "Export error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/graph/stats": {
      "get": {
