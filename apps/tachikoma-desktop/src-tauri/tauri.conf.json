{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TACHIKOMA-OS",
  "version": "0.1.0",
  "identifier": "com.tachikomaos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../neuro-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../../neuro-ui",
    "frontendDist": "../../../neuro-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TACHIKOMA-OS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI Assistant with Memory",
    "longDescription": "TACHIKOMA-OS is an AI-powered personal assistant with advanced memory capabilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/surrealdb",
      "binaries/tachikoma-backend",
      "binaries/tachikoma-checklists",
      "binaries/tachikoma-music",
      "binaries/tachikoma-chat",
      "binaries/tachikoma-memory",
      "binaries/tachikoma-agent"
    ],
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/madkoding/tachikoma/releases/latest/download/update.json"
      ]
    }
  }
}
